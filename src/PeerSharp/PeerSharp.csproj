<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Nullable analysis is escalated to errors so a null-flow mistake cannot merge. Mutation
		     testing is the one context where that backfires: Stryker rewrites expressions to probe the
		     tests, many rewrites produce a nullable warning, and an error makes the whole method
		     unmutatable - 48% of generated mutants were discarded as compile errors on the first run.
		     StrykerRun is set as an environment variable by the mutation job and reaches MSBuild as a
		     global property; every ordinary build, local or CI, is unaffected. -->
		<WarningsAsErrors Condition="'$(StrykerRun)' != 'true'">CS8600;CS8602;CS8603;CS8604;CS8618;CS8620;CS8625;CS8655;CS8669</WarningsAsErrors>
		<Authors>Peerfluence</Authors>
		<Copyright>Copyright (c) 2026 ligenq</Copyright>
		<Description>A high-performance BitTorrent engine for .NET.</Description>
		<PackageTags>bittorrent;torrent;p2p;peer-to-peer;dht;magnet;utp;streaming;download</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/ligenq/PeerSharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ligenq/PeerSharp</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>application-icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>PeerSharp 5.1.0 makes streaming to other devices work well: HttpStreamServer is socket-based and can serve a TV or cast receiver on the network, with an access token, CORS and files served beside the stream; Settings.Streaming tunes read-ahead and waits; a stream's pieces are fetched first, from every peer and web seed that has them, and spread across the swarm. It fixes uTP connections that stopped receiving, and hardens handshakes and encryption, piece verification, peer and DHT input, proxies, NAT mappings, bandwidth limiting, resume data and engine lifecycles. Passing a bare null as HttpStreamServer's third constructor argument is now ambiguous. See https://github.com/ligenq/PeerSharp/blob/v5.1.0/CHANGELOG.md.</PackageReleaseNotes>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsTrimmable>true</IsTrimmable>
		<!-- iOS allows no code generation at run time, so an app there is compiled ahead of time in
		     full. This turns on the AOT analyzers, and with warnings as errors any reflection or
		     dynamic code that would fail under AOT fails the build instead. -->
		<IsAotCompatible>true</IsAotCompatible>
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion>5.0.0</PackageValidationBaselineVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Include="application-icon.png" Pack="true" PackagePath="\" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>


	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>PeerSharp.Tests</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>PeerSharp.Benchmarks</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>PeerSharp.Fuzz</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
