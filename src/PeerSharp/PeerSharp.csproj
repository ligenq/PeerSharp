<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Nullable analysis is escalated to errors so a null-flow mistake cannot merge. Mutation
		     testing is the one context where that backfires: Stryker rewrites expressions to probe the
		     tests, many rewrites produce a nullable warning, and an error makes the whole method
		     unmutatable - 48% of generated mutants were discarded as compile errors on the first run.
		     StrykerRun is set as an environment variable by the mutation job and reaches MSBuild as a
		     global property; every ordinary build, local or CI, is unaffected. -->
		<WarningsAsErrors Condition="'$(StrykerRun)' != 'true'">CS8600;CS8602;CS8603;CS8604;CS8618;CS8620;CS8625;CS8655;CS8669</WarningsAsErrors>
		<Authors>Peerfluence</Authors>
		<Copyright>Copyright (c) 2026 ligenq</Copyright>
		<Description>A high-performance BitTorrent engine for .NET.</Description>
		<PackageTags>bittorrent;torrent;p2p;peer-to-peer;dht;magnet;utp;streaming;download</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/ligenq/PeerSharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ligenq/PeerSharp</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>application-icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>PeerSharp 5.2.0 reduces resume persistence and streaming memory use, improves libtorrent compatibility, and fixes hybrid uploads, metadata validation, peer availability, uTP handshakes and UDP tracker disposal. Adds directional MSE policies, BEP 17 HTTP seeds, SSL torrents over TCP/uTP and I2P SAM peer/tracker support. SSL and I2P have local protocol coverage but have not been validated against external SSL peers or a live I2P router. Binary compatible with 5.1.0. See https://github.com/ligenq/PeerSharp/blob/v5.2.0/CHANGELOG.md.</PackageReleaseNotes>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsTrimmable>true</IsTrimmable>
		<!-- iOS allows no code generation at run time, so an app there is compiled ahead of time in
		     full. This turns on the AOT analyzers, and with warnings as errors any reflection or
		     dynamic code that would fail under AOT fails the build instead. -->
		<IsAotCompatible>true</IsAotCompatible>
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion>5.1.0</PackageValidationBaselineVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Include="application-icon.png" Pack="true" PackagePath="\" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>


	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>PeerSharp.Tests</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>PeerSharp.Benchmarks</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>PeerSharp.Fuzz</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
