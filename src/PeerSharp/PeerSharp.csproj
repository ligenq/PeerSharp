<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>CS8600;CS8602;CS8603;CS8604;CS8618;CS8620;CS8625;CS8655;CS8669</WarningsAsErrors>
		<Authors>Peerfluence</Authors>
		<Copyright>Copyright (c) 2026 ligenq</Copyright>
		<Description>A high-performance BitTorrent engine for .NET.</Description>
		<PackageTags>bittorrent;torrent;p2p;peer-to-peer;dht;magnet;utp;streaming;download</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/ligenq/PeerSharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ligenq/PeerSharp</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>application-icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>PeerSharp 3.0 is a major release with intentional breaking API changes: IClientEngine adds BEP 46 publishing/resolution and BEP 51 discovery members, and ITorrent.SetDownloadPathAsync now accepts a CancellationToken; consumers implementing or mocking these interfaces must update and recompile. New protocol support includes BEP 44 mutable/immutable DHT items with Ed25519 signatures, BEP 46 self-updating torrents, BEP 51 info-hash sampling and crawling, tracker enhancements from BEP 24/31/41, DHT read-only mode from BEP 43, upload-only signaling from BEP 21, and lt_donthave from BEP 54. Reliability and performance work covers parallel storage/session I/O, faster deterministic shutdown, cancellation and teardown races, rate limits on every peer transport, encrypted inbound uTP and MSE interoperability, pipelined-handshake preservation, metadata-request redundancy, tracker retry semantics, and extensive real-swarm, concurrency, trim, API-surface, and benchmark guards. Packages now include XML documentation and Source Link symbol packages.</PackageReleaseNotes>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsTrimmable>true</IsTrimmable>
	</PropertyGroup>

	<ItemGroup>
		<None Include="application-icon.png" Pack="true" PackagePath="\" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.29.0.143774">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Types\**\*.cs" />
		<Compile Remove="Internals\Utilities\Bencode\**\*.cs" />
		<Compile Remove="Internals\Peers\MessageId.cs" />
		<Compile Remove="Internals\Peers\PeerMessage.cs" />
		<Compile Remove="Internals\Pieces\PiecePicker.cs" />
		<Compile Remove="Internals\Pieces\IPiecePickerContext.cs" />
		<Compile Remove="Internals\Pieces\PiecesProgress.cs" />
		<Compile Remove="Internals\Pieces\PieceChecker.cs" />
		<Compile Remove="Internals\Pieces\Block.cs" />
		<Compile Remove="Internals\IO\**\*.cs" />
		<Compile Remove="Internals\Streaming\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>PeerSharp.Tests</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>PeerSharp.Benchmarks</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
