<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Nullable analysis is escalated to errors so a null-flow mistake cannot merge. Mutation
		     testing is the one context where that backfires: Stryker rewrites expressions to probe the
		     tests, many rewrites produce a nullable warning, and an error makes the whole method
		     unmutatable - 48% of generated mutants were discarded as compile errors on the first run.
		     StrykerRun is set as an environment variable by the mutation job and reaches MSBuild as a
		     global property; every ordinary build, local or CI, is unaffected. -->
		<WarningsAsErrors Condition="'$(StrykerRun)' != 'true'">CS8600;CS8602;CS8603;CS8604;CS8618;CS8620;CS8625;CS8655;CS8669</WarningsAsErrors>
		<Authors>Peerfluence</Authors>
		<Copyright>Copyright (c) 2026 ligenq</Copyright>
		<Description>A high-performance BitTorrent engine for .NET.</Description>
		<PackageTags>bittorrent;torrent;p2p;peer-to-peer;dht;magnet;utp;streaming;download</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/ligenq/PeerSharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ligenq/PeerSharp</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>application-icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>PeerSharp 5.4.0 leaves a session as it was across a restart. Renames, file selections and progress are now saved for stopped and never-started torrents, a paused session comes back paused, torrents waiting in the queue stay there, and ratio limits count earlier sessions. Stopping and starting a torrent after a restart no longer throws away pieces in files it had written to, and a file check no longer holds up the queue. Adds IClientEngine.SessionRestoredPaused. Binary compatible with 5.3.1. See https://github.com/ligenq/PeerSharp/blob/v5.4.0/CHANGELOG.md.</PackageReleaseNotes>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsTrimmable>true</IsTrimmable>
		<!-- iOS allows no code generation at run time, so an app there is compiled ahead of time in
		     full. This turns on the AOT analyzers, and with warnings as errors any reflection or
		     dynamic code that would fail under AOT fails the build instead. -->
		<IsAotCompatible>true</IsAotCompatible>
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion>5.3.1</PackageValidationBaselineVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Include="application-icon.png" Pack="true" PackagePath="\" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>


	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>PeerSharp.Tests</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>PeerSharp.Benchmarks</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>PeerSharp.Fuzz</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
