<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Nullable analysis is escalated to errors so a null-flow mistake cannot merge. Mutation
		     testing is the one context where that backfires: Stryker rewrites expressions to probe the
		     tests, many rewrites produce a nullable warning, and an error makes the whole method
		     unmutatable - 48% of generated mutants were discarded as compile errors on the first run.
		     StrykerRun is set as an environment variable by the mutation job and reaches MSBuild as a
		     global property; every ordinary build, local or CI, is unaffected. -->
		<WarningsAsErrors Condition="'$(StrykerRun)' != 'true'">CS8600;CS8602;CS8603;CS8604;CS8618;CS8620;CS8625;CS8655;CS8669</WarningsAsErrors>
		<Authors>Peerfluence</Authors>
		<Copyright>Copyright (c) 2026 ligenq</Copyright>
		<Description>Optional WebTorrent over WebRTC support for PeerSharp.</Description>
		<PackageTags>bittorrent;torrent;p2p;peer-to-peer;webtorrent;webrtc</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/ligenq/PeerSharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ligenq/PeerSharp</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>application-icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>PeerSharp.WebTorrent 4.0.0 targets PeerSharp 4.0.0 and contains no WebTorrent-specific API changes. See https://github.com/ligenq/PeerSharp/blob/main/CHANGELOG.md for the core engine changes included in this release.</PackageReleaseNotes>
		<IsTrimmable>true</IsTrimmable>
		<RootNamespace>PeerSharp.WebTorrent</RootNamespace>
		<AssemblyName>PeerSharp.WebTorrent</AssemblyName>
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion>4.0.0</PackageValidationBaselineVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\PeerSharp\application-icon.png" Pack="true" PackagePath="\" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PeerSharp\PeerSharp.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
		<PackageReference Include="RtcForge" Version="1.0.0" />
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.33.0.1635">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>PeerSharp.WebTorrent.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
